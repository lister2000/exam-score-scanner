<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- 1. 画面背景 -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 2. 识别框叠加层（比画面高一层） -->
    <com.examscan.score.OverlayView
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 3. 顶部：总分 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#99000000"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/totalText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="总分 0"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="已拍 0 次 · 共 0 处"
            android:textColor="#CCFFFFFF"
            android:textSize="14sp" />

        <!-- 本次拍照的加法式子，如 "3 + 5 = 8"，拍完显示，重拍清空 -->
        <TextView
            android:id="@+id/shotFormula"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#22c55e"
            android:textSize="22sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 4. 中部提示 -->
    <TextView
        android:id="@+id/hintText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="120dp"
        android:background="#66000000"
        android:paddingStart="14dp"
        android:paddingTop="7dp"
        android:paddingEnd="14dp"
        android:paddingBottom="7dp"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:text="@string/hint_default" />

    <!-- 5. 右上角：设置按钮（半透明，非圆形） -->
    <Button
        android:id="@+id/btnSettings"
        android:layout_width="98dp"
        android:layout_height="67dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:background="#66000000"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingStart="14dp"
        android:paddingTop="0dp"
        android:paddingEnd="14dp"
        android:paddingBottom="0dp"
        android:text="⚙ 设置"
        android:textColor="#FFFFFF"
        android:textSize="18sp" />

    <!-- 6. 圆形拍照按钮 -->
    <Button
        android:id="@+id/btnShutter"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="88dp"
        android:background="@drawable/btn_circle"
        android:text="@string/btn_shutter"
        android:textColor="#000000"
        android:textSize="16sp"
        android:visibility="visible" />

    <!-- 7. 底部：始终显示的一行按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#99000000"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRetake"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="@string/btn_retake"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnAddLearn"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="#7B1FA2"
                android:minWidth="0dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="@string/btn_add_learn"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnReset"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="#B71C1C"
                android:minWidth="0dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="@string/btn_restart"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnGoLearn"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="#2E7D32"
                android:minWidth="0dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="@string/btn_go_learn"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
